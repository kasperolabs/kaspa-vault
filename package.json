{
  "name": "kaspa-vault",
  "version": "0.1.0",
  "description": "A savings vault for Kaspa: covenants that only release after a delay, a watcher that alerts and rescues, and a drop-in widget.",
  "main": "core/index.js",
  "scripts": {
    "test": "node test/spend.js && node test/lifecycle.js && node test/watcher.js && node test/wallet.js",
    "test:equality": "node test/compiler-equality.js 500",
    "test:live": "node test/live.js",
    "test:engine": "tools/engine-test.sh",
    "build:templates": "node tools/build-templates.js",
    "dev:world": "node test/dev-world.js",
    "drill:local": "tools/drill-local.sh",
    "build:widget": "node tools/build-widget.js",
    "test:widget": "node tools/build-widget.js && node test/widget-e2e.js",
    "demo": "node tools/serve.js",
    "test:site": "node tools/build-widget.js && node test/site-smoke.js"
  },
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@noble/secp256k1": "3.2.0",
    "@scure/bip39": "2.4.0",
    "kaspa-ksm": "1.0.2",
    "qrcode-generator": "2.0.4"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "exports": {
    ".": "./core/index.js",
    "./core": "./core/index.js",
    "./widget": "./widget/dist/kaspa-vault.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kasperolabs/kaspa-vault"
  },
  "homepage": "https://kaspavault.com"
}
