# kaspa-vault watcher. Copy to .env, chmod 600, owned by the watcher's own user.

# ---- identity ----
# node gen-key.js prints this line. Back it up offline, in two places: it is what rescues vaults if this box dies.
GUARDIAN_PRIVKEY=
WATCHER_NAME=watch.kaspavault.com
PUBLIC_URL=https://watch.kaspavault.com
SITE_URL=https://kaspavault.com
NETWORK=mainnet

# ---- network ----
PORT=7332
HOST=127.0.0.1
# Tried in order; the next one is used only when one cannot be reached. ws:// = kaspad JSON wRPC
# (kaspad --rpclisten-json=127.0.0.1:18110), https:// = a Kaspa REST API.
KASPA_NODES=ws://127.0.0.1:18110,https://api.kaspa.org
POLL_MS=20000
POLL_FAIL_ALERT=5
# Release matured withdrawals by itself (needs no key; it can only pay the vault's own wallet)
RELEASE=true

# ---- policy ----
# The shortest waiting time this watcher accepts, in DAA (10 per second). 864000 = 24 hours.
# For a test round use 3000 (5 minutes); it only affects new registrations.
MIN_DELAY_DAA=864000
MAX_VAULTS=1000
MAX_VAULTS_PER_EMAIL=5
MAX_SUBSCRIBERS_PER_VAULT=5
MAX_PENDING=500
PENDING_TTL_HOURS=24
REGISTER_PER_IP_HOUR=6
REGISTER_PER_HOUR=120
EMERGENCY_PER_IP_HOUR=6
SIGNATURE_MAX_AGE_MIN=30
# nginx: trust X-Real-IP from 127.0.0.1 (set by the nginx config in this folder)
TRUST_PROXY=nginx
# Browsers that may call /v1/*. * is fine: the API has no cookies and every request is signed.
CORS_ORIGINS=*

# ---- mail ----
# Use a mail account of its own, not the one Kasla or anything else sends from.
# MAIL_TRANSPORT=log writes every email to data/outbox.log instead of sending (first install, testing).
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kaspa Vault watcher <watch@kaspavault.com>"
ADMIN_EMAIL=

DATA_DIR=data
